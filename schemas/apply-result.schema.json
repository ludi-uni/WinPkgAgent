{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://winpkg-agent.dev/schema/apply-result.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "status", "startedAt", "finishedAt", "operations", "rebootRequired", "warnings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "planId": { "type": "string", "format": "uuid" },
    "status": { "enum": ["success", "partial-failure", "what-if", "failed"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["manager", "id", "operation", "status", "reasonCode"],
        "properties": {
          "manager": { "enum": ["winget", "scoop"] },
          "id": { "type": "string" },
          "operation": { "enum": ["install", "upgrade"] },
          "status": { "enum": ["completed", "failed", "not-run", "what-if"] },
          "reasonCode": { "type": "string" },
          "exitCode": { "type": ["integer", "null"] },
          "durationMs": { "type": "integer", "minimum": 0 },
          "stdout": { "type": "string" },
          "stderr": { "type": "string" },
          "rebootRequired": { "type": "boolean" },
          "hash": { "type": "string" },
          "length": { "type": "integer", "minimum": 0 },
          "truncated": { "type": "boolean" }
        }
      }
    },
    "rebootRequired": { "type": "boolean" },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
